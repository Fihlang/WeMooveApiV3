# Node environment: development, production, test
NODE_ENV=development

# Database connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/furniture_delivery

# Server port
PORT=5000

# Session secret for authentication
SESSION_SECRET=your_secure_session_secret_key_here

# JWT secret for API authentication
JWT_SECRET=your_secure_jwt_secret_key_here

# Cors settings
CORS_ORIGIN=http://localhost:3000

# WebSocket path
WS_PATH=/ws

# Logging level: error, warn, info, http, verbose, debug, silly
LOG_LEVEL=info

# Email configuration
# For development, leave these commented out to use Ethereal test accounts
# For production, uncomment and configure with your SMTP service
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=user@example.com
# SMTP_PASS=your_smtp_password
# EMAIL_FROM=Furniture Delivery <no-reply@furnituredelivery.co.za>

# Cloud storage for file uploads (if needed)
# CLOUD_API_KEY=your_cloud_api_key
# CLOUD_API_SECRET=your_cloud_api_secret
# CLOUD_NAME=your_cloud_name

# Payment gateway (if needed)
# PAYMENT_API_KEY=your_payment_api_key
# PAYMENT_SECRET_KEY=your_payment_secret_key

# Google Maps API key (for geocoding and mapping)
# GOOGLE_MAPS_API_KEY=your_google_maps_api_key